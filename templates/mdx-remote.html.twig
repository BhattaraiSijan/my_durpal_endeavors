{#
/**
 * @file
 * Theme implementation for the MDX Remote Renderer container.
 *
 * This template renders a placeholder div that will be targeted by JavaScript
 * to initialize the React MDX renderer.
 *
 * The MDX content and settings are passed automatically via the #attached
 * property in the corresponding FieldFormatter (MDXRemoteFormatter.php),
  * so no <script> tag is needed here.
 *
 * Available variables:
 * - unique_id: A unique HTML ID for this specific MDX block instance.
 * - style: The rendering style setting.
 * - attributes: HTML attributes for the container element.
 */
#}
<div {{ attributes.addClass('mdx-remote-container', 'mdx-style-' ~ style) }} id="{{ unique_id }}">
  {# This content will be replaced by the React component once it loads. #}
  <p class="mdx-loading-placeholder">{{ 'Loading MDX content...'|t }}</p>
</div>
